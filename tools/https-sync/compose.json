{
  "name": "sakie-sync-acceptance",
  "services": {
    "cloud": {
      "build": {"context": ".", "dockerfile": "tools/https-sync/Dockerfile"},
      "image": "sakie-sync-acceptance:${ACCEPTANCE_RUN_ID:?required}",
      "environment": {"ACCEPTANCE_RUN_ID":"${ACCEPTANCE_RUN_ID:?required}","PUBLIC_ORIGIN":"${PUBLIC_ORIGIN:?required}"},
      "user":"1000:1000", "read_only":true, "tmpfs":["/tmp:rw,noexec,nosuid,size=16m"],
      "ports":["127.0.0.1:3301:3000"],
      "volumes":[
        {"type":"bind","source":"/srv/sakie-sync-acceptance/data","target":"/app/synthetic-data","bind":{"create_host_path":false}},
        {"type":"bind","source":"/srv/sakie-sync-acceptance/identity","target":"/run/synthetic-identity","read_only":true,"bind":{"create_host_path":false}}
      ],
      "cap_drop":["ALL"],"security_opt":["no-new-privileges:true"],"pids_limit":64,"mem_limit":"384m","cpus":0.5,
      "restart":"no","stop_grace_period":"20s","networks":["isolated"],
      "logging":{"driver":"json-file","options":{"max-size":"5m","max-file":"2"}},
      "healthcheck":{"test":["CMD","node","-e","fetch('http://127.0.0.1:3000/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"],"interval":"15s","timeout":"5s","retries":3}
    },
    "initialize": {
      "image":"sakie-sync-acceptance:${ACCEPTANCE_RUN_ID:?required}","profiles":["initialize"],
      "command":["node","tools/https-sync/cloud.mjs","--init"],"environment":{"ACCEPTANCE_RUN_ID":"${ACCEPTANCE_RUN_ID:?required}"},
      "user":"1000:1000","read_only":true,"network_mode":"none","cap_drop":["ALL"],"security_opt":["no-new-privileges:true"],
      "volumes":[
        {"type":"bind","source":"/srv/sakie-sync-acceptance/data","target":"/app/synthetic-data","bind":{"create_host_path":false}},
        {"type":"bind","source":"/srv/sakie-sync-acceptance/identity","target":"/run/synthetic-identity","bind":{"create_host_path":false}}
      ]
    }
  },
  "networks":{"isolated":{"internal":true}}
}
