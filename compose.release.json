{
  "services": {
    "backend": {
      "build": {"context": ".", "dockerfile": "backend/Dockerfile"},
      "env_file": ["${BACKEND_ENV_FILE:?Set a private backend environment file}"],
      "environment": {
        "NODE_ENV": "production", "HOST": "0.0.0.0", "PORT": "3000", "RUNTIME_ROLE": "cloud",
        "PUBLIC_ORIGIN": "${PUBLIC_ORIGIN:?Set the exact HTTPS website origin}",
        "DATA_DIR": "/app/data", "DATABASE_PATH": "/app/data/sakie.db",
        "BACKUP_DIR": "/app/backups", "OWNER_CREDENTIAL_FILE": "/run/sakie/owner.json"
      },
      "volumes": [
        {"type": "volume", "source": "sakie-data", "target": "/app/data", "volume": {"nocopy": true}},
        {"type": "volume", "source": "sakie-backups", "target": "/app/backups", "volume": {"nocopy": true}},
        {"type": "bind", "source": "${OWNER_CREDENTIAL_FILE_HOST:?Set a pre-existing private identity file}", "target": "/run/sakie/owner.json", "read_only": true, "bind": {"create_host_path": false}}
      ],
      "restart": "unless-stopped", "stop_grace_period": "20s",
      "logging": {"driver": "json-file", "options": {"max-size": "10m", "max-file": "3"}},
      "healthcheck": {"test": ["CMD", "node", "-e", "fetch('http://127.0.0.1:3000/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"], "interval": "30s", "timeout": "5s", "start_period": "10s", "retries": 3}
    },
    "frontend": {
      "build": {"context": ".", "dockerfile": "frontend/Dockerfile"},
      "ports": ["127.0.0.1:${HTTP_PORT:-8080}:80"],
      "depends_on": {"backend": {"condition": "service_healthy"}},
      "restart": "unless-stopped",
      "logging": {"driver": "json-file", "options": {"max-size": "10m", "max-file": "3"}}
    }
  },
  "volumes": {
    "sakie-data": {"external": true, "name": "${SAKIE_DATA_VOLUME:?Select the audited existing database volume}"},
    "sakie-backups": {"external": true, "name": "${SAKIE_BACKUP_VOLUME:?Select the audited existing backup volume}"}
  }
}
