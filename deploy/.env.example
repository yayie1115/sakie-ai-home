# Compose interpolation only; copy outside the repository and use --env-file.
PUBLIC_ORIGIN=https://sakiehome.icu
SAKIE_CHAT_HTTP_PORT=3402
SAKIE_CLOUD_DATA_DIR=/srv/sakie-home/data
SAKIE_CLOUD_BACKUP_DIR=/srv/sakie-home/backups
SAKIE_OWNER_FILE=/srv/sakie-home/identity/owner.json
SAKIE_BACKEND_ENV_FILE=/srv/sakie-home/identity/backend.env
# Put DEEPSEEK_API_KEY, DEEPSEEK_MODEL and approved CHAT_SYSTEM_PROMPT only in
# the private backend.env above. No keys or passwords belong in this template.
