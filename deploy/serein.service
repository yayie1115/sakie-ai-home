[Unit]
Description=Serein private memory API (pinned source)
After=network-online.target
Wants=network-online.target

[Service]
User=serein
Group=serein
WorkingDirectory=/opt/serein/source
Environment=SEREIN_HTTP_TOKEN_FILE=/etc/serein/api-token
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
# Source policy is closed by default. This wrapper requires the audited,
# unchanged upstream revision and an already initialized schema v9 database.
ExecStart=/opt/serein/venv/bin/python /opt/morrow/serein_source_host.py --config /etc/serein/config.toml --policy /etc/serein/source-policy.json --upstream-root /opt/serein/source --port 8011
Restart=on-failure
RestartSec=10
UMask=0077
MemoryMax=768M
MemoryHigh=640M
CPUQuota=50%
TasksMax=64
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/serein

[Install]
WantedBy=multi-user.target
