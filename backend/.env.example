NODE_ENV=development
HOST=127.0.0.1
PORT=3000
RUNTIME_ROLE=cloud
PUBLIC_ORIGIN=http://127.0.0.1:5173
# Development also permits the equivalent localhost origin on the same port.
# Defaults are outside the source project; paths below are examples, not required overrides.
# DATA_DIR=E:/sakie-ai-home-data/cloud
# BACKUP_DIR=E:/sakie-ai-home-backups/cloud
# DATABASE_PATH=E:/sakie-ai-home-data/cloud/sakie.db
# OWNER_CREDENTIAL_FILE=E:/sakie-ai-home-data/cloud/auth/owner.json
SESSION_HOURS=168
# Production MUST explicitly set PUBLIC_ORIGIN=https://sakiehome.icu,
# provision writable database/backup volumes and configure owner identity before exposure.
