NODE_ENV=development
HOST=127.0.0.1
PORT=3000
RUNTIME_ROLE=cloud
PUBLIC_ORIGIN=http://127.0.0.1:5173
# Development also permits the equivalent localhost origin on the same port.
# Defaults are outside the source project; paths below are examples, not required overrides.
# DATA_DIR=E:/sakie-ai-home-data/cloud
# BACKUP_DIR=E:/sakie-ai-home-backups/cloud
# DATABASE_PATH=E:/sakie-ai-home-data/cloud/sakie.db
# OWNER_CREDENTIAL_FILE=E:/sakie-ai-home-data/cloud/auth/owner.json
SESSION_HOURS=168
# Production MUST explicitly set PUBLIC_ORIGIN=https://sakiehome.icu,
# provision writable database/backup volumes and configure owner identity before exposure.

# Phase 2: backend only. Empty key/model disables NEW model calls; history remains readable.
# Obtain your own key and set it only in ignored backend/.env. Never use a VITE_ variable.
DEEPSEEK_API_KEY=
# Set an available official model explicitly (see DeepSeek official model list).
DEEPSEEK_MODEL=
DEEPSEEK_BASE_URL=https://api.deepseek.com
MODEL_TIMEOUT_MS=60000
CHAT_MAX_OUTPUT_TOKENS=1024
CHAT_CONTEXT_TURNS=12
CHAT_CONTEXT_MAX_CHARS=48000
CHAT_MAX_MESSAGE_CHARS=12000
CHAT_MAX_QUEUED_TURNS=16
# Optional stable persona; do not inject complete historical data here.
# CHAT_SYSTEM_PROMPT=
