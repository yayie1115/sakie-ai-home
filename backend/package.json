{
  "name": "@sakie/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "start": "node dist/server.js",
    "test": "tsx --test test/*.test.ts",
    "db:prepare": "tsx src/cli.ts prepare",
    "db:backup": "tsx src/cli.ts backup",
    "db:verify": "tsx src/cli.ts verify",
    "db:restore": "tsx src/cli.ts restore",
    "db:migrate": "tsx src/cli.ts migrate",
    "auth:setup": "tsx src/cli.ts auth-setup"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "@sakie/contracts": "0.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
